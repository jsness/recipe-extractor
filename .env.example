HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/recipes?sslmode=disable
FRONTEND_DEV_PROXY_URL=

# Extractor backend: openai, anthropic, or local
EXTRACTOR=anthropic
LLM_ONLY_EXTRACTION=false

# OpenAI settings for recipe normalization
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
OPENAI_TIMEOUT_SECONDS=45

# Anthropic settings for recipe normalization
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=45

# Local OpenAI-compatible settings for recipe normalization
# When the app runs in Docker and the LLM runs on the host, use http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_TIMEOUT_SECONDS=45
